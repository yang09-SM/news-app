<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.UserAchievementMapper">

    <resultMap type="UserAchievement" id="UserAchievementResult">
        <result property="achievementId"   column="achievement_id"   />
        <result property="userId"          column="user_id"          />
        <result property="achievementName" column="achievement_name" />
        <result property="achievementCode" column="achievement_code" />
        <result property="description"     column="description"      />
        <result property="icon"            column="icon"             />
        <result property="pointsReward"    column="points_reward"    />
        <result property="isUnlocked"      column="is_unlocked"     />
        <result property="unlockTime"      column="unlock_time"      />
        <result property="delFlag"         column="del_flag"         />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"           />
    </resultMap>

    <sql id="selectAchievementVo">
        select achievement_id, user_id, achievement_name, achievement_code, description, icon, points_reward, is_unlocked, unlock_time, del_flag, create_by, create_time, update_by, update_time, remark
		from user_achievement
    </sql>

    <select id="selectAchievementById" parameterType="Long" resultMap="UserAchievementResult">
        <include refid="selectAchievementVo"/>
        where achievement_id = #{achievementId}
    </select>

    <select id="selectAchievementList" parameterType="UserAchievement" resultMap="UserAchievementResult">
        <include refid="selectAchievementVo"/>
        <where>
			del_flag = '0'
			<if test="userId != null">
				AND user_id = #{userId}
			</if>
			<if test="achievementCode != null and achievementCode != ''">
				AND achievement_code = #{achievementCode}
			</if>
			<if test="isUnlocked != null and isUnlocked != ''">
				AND is_unlocked = #{isUnlocked}
			</if>
		</where>
		order by create_time desc
    </select>

    <insert id="insertAchievement" parameterType="UserAchievement">
        insert into user_achievement (
			<if test="userId != null">user_id, </if>
			<if test="achievementName != null and achievementName != ''">achievement_name, </if>
			<if test="achievementCode != null and achievementCode != ''">achievement_code, </if>
			<if test="description != null and description != ''">description, </if>
			<if test="icon != null and icon != ''">icon, </if>
			<if test="pointsReward != null">points_reward, </if>
			<if test="isUnlocked != null and isUnlocked != ''">is_unlocked, </if>
			<if test="unlockTime != null">unlock_time, </if>
			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
			<if test="userId != null">#{userId}, </if>
			<if test="achievementName != null and achievementName != ''">#{achievementName}, </if>
			<if test="achievementCode != null and achievementCode != ''">#{achievementCode}, </if>
			<if test="description != null and description != ''">#{description}, </if>
			<if test="icon != null and icon != ''">#{icon}, </if>
			<if test="pointsReward != null">#{pointsReward}, </if>
			<if test="isUnlocked != null and isUnlocked != ''">#{isUnlocked}, </if>
			<if test="unlockTime != null">#{unlockTime}, </if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
		)
    </insert>

    <update id="updateAchievement" parameterType="UserAchievement">
        update user_achievement
        <set>
            <if test="userId != null">user_id = #{userId}, </if>
            <if test="achievementName != null and achievementName != ''">achievement_name = #{achievementName}, </if>
            <if test="achievementCode != null and achievementCode != ''">achievement_code = #{achievementCode}, </if>
            <if test="description != null and description != ''">description = #{description}, </if>
            <if test="icon != null and icon != ''">icon = #{icon}, </if>
            <if test="pointsReward != null">points_reward = #{pointsReward}, </if>
            <if test="isUnlocked != null and isUnlocked != ''">is_unlocked = #{isUnlocked}, </if>
            <if test="unlockTime != null">unlock_time = #{unlockTime}, </if>
            <if test="remark != null">remark = #{remark}, </if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
        </set>
        where achievement_id = #{achievementId}
    </update>

    <delete id="deleteAchievementByIds" parameterType="String">
        delete from user_achievement where achievement_id in
        <foreach item="achievementId" collection="array" open="(" separator="," close=")">
            #{achievementId}
        </foreach>
    </delete>

</mapper>
