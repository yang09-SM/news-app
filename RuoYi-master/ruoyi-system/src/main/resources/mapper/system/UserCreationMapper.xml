<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.UserCreationMapper">

    <resultMap type="UserCreation" id="UserCreationResult">
        <result property="creationId"    column="creation_id"    />
        <result property="userId"        column="user_id"        />
        <result property="title"         column="title"          />
        <result property="coverImage"    column="cover_image"    />
        <result property="content"       column="content"        />
        <result property="creationType"  column="creation_type"  />
        <result property="status"        column="status"          />
        <result property="viewCount"     column="view_count"     />
        <result property="likeCount"     column="like_count"     />
        <result property="commentCount"  column="comment_count"  />
        <result property="delFlag"       column="del_flag"       />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectCreationVo">
        select creation_id, user_id, title, cover_image, content, creation_type, status, view_count, like_count, comment_count, del_flag, create_by, create_time, update_by, update_time, remark
		from user_creation
    </sql>

    <select id="selectCreationById" parameterType="Long" resultMap="UserCreationResult">
        <include refid="selectCreationVo"/>
        where creation_id = #{creationId}
    </select>

    <select id="selectCreationList" parameterType="UserCreation" resultMap="UserCreationResult">
        <include refid="selectCreationVo"/>
        <where>
			del_flag = '0'
			<if test="userId != null">
				AND user_id = #{userId}
			</if>
			<if test="title != null and title != ''">
				AND title like concat('%', #{title}, '%')
			</if>
			<if test="creationType != null and creationType != ''">
				AND creation_type = #{creationType}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by create_time desc
    </select>

    <insert id="insertCreation" parameterType="UserCreation">
        insert into user_creation (
			<if test="userId != null">user_id, </if>
			<if test="title != null and title != ''">title, </if>
			<if test="coverImage != null and coverImage != ''">cover_image, </if>
			<if test="content != null and content != ''">content, </if>
			<if test="creationType != null and creationType != ''">creation_type, </if>
			<if test="status != null and status != ''">status, </if>
			<if test="viewCount != null">view_count, </if>
			<if test="likeCount != null">like_count, </if>
			<if test="commentCount != null">comment_count, </if>
			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
			<if test="userId != null">#{userId}, </if>
			<if test="title != null and title != ''">#{title}, </if>
			<if test="coverImage != null and coverImage != ''">#{coverImage}, </if>
			<if test="content != null and content != ''">#{content}, </if>
			<if test="creationType != null and creationType != ''">#{creationType}, </if>
			<if test="status != null and status != ''">#{status}, </if>
			<if test="viewCount != null">#{viewCount}, </if>
			<if test="likeCount != null">#{likeCount}, </if>
			<if test="commentCount != null">#{commentCount}, </if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
		)
    </insert>

    <update id="updateCreation" parameterType="UserCreation">
        update user_creation
        <set>
            <if test="userId != null">user_id = #{userId}, </if>
            <if test="title != null and title != ''">title = #{title}, </if>
            <if test="coverImage != null and coverImage != ''">cover_image = #{coverImage}, </if>
            <if test="content != null and content != ''">content = #{content}, </if>
            <if test="creationType != null and creationType != ''">creation_type = #{creationType}, </if>
            <if test="status != null and status != ''">status = #{status}, </if>
            <if test="viewCount != null">view_count = #{viewCount}, </if>
            <if test="likeCount != null">like_count = #{likeCount}, </if>
            <if test="commentCount != null">comment_count = #{commentCount}, </if>
            <if test="remark != null">remark = #{remark}, </if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
        </set>
        where creation_id = #{creationId}
    </update>

    <delete id="deleteCreationByIds" parameterType="String">
        delete from user_creation where creation_id in
        <foreach item="creationId" collection="array" open="(" separator="," close=")">
            #{creationId}
        </foreach>
    </delete>

</mapper>
