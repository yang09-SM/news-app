<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NewsArticleMapper">
    
    <resultMap type="NewsArticle" id="NewsArticleResult">
        <result property="articleId"       column="article_id"       />
        <result property="title"           column="title"            />
        <result property="categoryId"      column="category_id"      />
        <result property="coverImage"      column="cover_image"      />
        <result property="summary"         column="summary"          />
        <result property="content"         column="content"          />
        <result property="status"          column="status"           />
        <result property="viewCount"       column="view_count"       />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"           />
        <result property="authorId"        column="author_id"        />
        <result property="newsType"        column="news_type"        />
        <result property="videoUrl"        column="video_url"        />
        <result property="audioUrl"        column="audio_url"        />
        <result property="duration"        column="duration"         />
        <result property="source"          column="source"           />
        <result property="likeCount"       column="like_count"       />
        <result property="commentCount"    column="comment_count"    />
        <result property="delFlag"         column="del_flag"         />
    </resultMap>
    
    <sql id="selectNewsArticleVo">
        select article_id, title, category_id, cover_image, summary, cast(content as char) as content, status, view_count, author_id, news_type, video_url, audio_url, duration, source, like_count, comment_count, del_flag, create_by, create_time, update_by, update_time, remark
		from news_article
    </sql>
    
    <select id="selectNewsArticleById" parameterType="Long" resultMap="NewsArticleResult">
        <include refid="selectNewsArticleVo"/>
        where article_id = #{articleId}
    </select>
    
    <select id="selectNewsArticleList" parameterType="NewsArticle" resultMap="NewsArticleResult">
        <include refid="selectNewsArticleVo"/>
        <where>
			AND del_flag = '0'
			<if test="title != null and title != ''">
				AND title like concat('%', #{title}, '%')
			</if>
			<if test="categoryId != null">
				AND category_id = #{categoryId}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="createBy != null and createBy != ''">
				AND create_by like concat('%', #{createBy}, '%')
			</if>
		</where>
		order by article_id desc
    </select>
    
    <insert id="insertNewsArticle" parameterType="NewsArticle">
        insert into news_article (
			<if test="title != null and title != '' ">title, </if>
			<if test="categoryId != null ">category_id, </if>
			<if test="coverImage != null and coverImage != '' ">cover_image, </if>
			<if test="summary != null and summary != '' ">summary, </if>
			<if test="content != null and content != '' ">content, </if>
			<if test="status != null and status != '' ">status, </if>
			<if test="viewCount != null">view_count, </if>
			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
			<if test="title != null and title != ''">#{title}, </if>
			<if test="categoryId != null">#{categoryId}, </if>
			<if test="coverImage != null and coverImage != ''">#{coverImage}, </if>
			<if test="summary != null and summary != ''">#{summary}, </if>
			<if test="content != null and content != ''">#{content}, </if>
			<if test="status != null and status != ''">#{status}, </if>
			<if test="viewCount != null">#{viewCount}, </if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
		)
    </insert>
	 
    <update id="updateNewsArticle" parameterType="NewsArticle">
        update news_article 
        <set>
            <if test="title != null and title != ''">title = #{title}, </if>
            <if test="categoryId != null">category_id = #{categoryId}, </if>
            <if test="coverImage != null">cover_image = #{coverImage}, </if>
            <if test="summary != null">summary = #{summary}, </if>
            <if test="content != null">content = #{content}, </if>
            <if test="status != null and status != ''">status = #{status}, </if>
            <if test="viewCount != null">view_count = #{viewCount}, </if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
        </set>
        where article_id = #{articleId}
    </update>
	
    <delete id="deleteNewsArticleByIds" parameterType="String">
        delete from news_article where article_id in 
        <foreach item="articleId" collection="array" open="(" separator="," close=")">
            #{articleId}
        </foreach>
    </delete>
    
    <select id="selectPublishedNewsList" parameterType="NewsArticle" resultMap="NewsArticleResult">
        <include refid="selectNewsArticleVo"/>
        <where>
            status = '1'
			<if test="title != null and title != ''">
				AND title like concat('%', #{title}, '%')
			</if>
			<if test="categoryId != null">
				AND category_id = #{categoryId}
			</if>
		</where>
		order by article_id desc
    </select>
    
    <update id="incrementViewCount" parameterType="Long">
        update news_article set view_count = view_count + 1 where article_id = #{articleId}
    </update>

    <select id="selectHotNewsList" resultMap="NewsArticleResult">
        <include refid="selectNewsArticleVo"/>
        where status = '1'
        order by view_count desc, article_id desc
        limit 20
    </select>

    <select id="searchNews" parameterType="String" resultMap="NewsArticleResult">
        <include refid="selectNewsArticleVo"/>
        where status = '1'
        and (title like concat('%', #{keyword}, '%')
        or summary like concat('%', #{keyword}, '%'))
        order by article_id desc
    </select>

    <select id="selectRecommendedNews" parameterType="Long" resultMap="NewsArticleResult">
        <include refid="selectNewsArticleVo"/>
        where status = '1'
        order by article_id desc
        limit 10
    </select>

    <select id="selectNewsByCategory" parameterType="Long" resultMap="NewsArticleResult">
        <include refid="selectNewsArticleVo"/>
        where status = '1'
        and category_id = #{categoryId}
        order by article_id desc
    </select>
    
</mapper>
