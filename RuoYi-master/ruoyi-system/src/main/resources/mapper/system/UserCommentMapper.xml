<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.UserCommentMapper">
    
    <resultMap type="UserComment" id="UserCommentResult">
        <result property="commentId"       column="comment_id"       />
        <result property="articleId"       column="article_id"       />
        <result property="userId"          column="user_id"          />
        <result property="userName"        column="user_name"        />
        <result property="userAvatar"      column="user_avatar"      />
        <result property="content"         column="content"          />
        <result property="parentId"        column="parent_id"        />
        <result property="replyToUserId"   column="reply_to_user_id" />
        <result property="replyToUserName" column="reply_to_user_name" />
        <result property="likeCount"       column="like_count"       />
        <result property="replyCount"      column="reply_count"      />
        <result property="isTop"           column="is_top"           />
        <result property="status"          column="status"           />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"           />
        <result property="delFlag"         column="del_flag"         />
    </resultMap>
    
    <sql id="selectUserCommentVo">
        select comment_id, article_id, user_id, user_name, user_avatar, content, parent_id, reply_to_user_id, reply_to_user_name, like_count, reply_count, is_top, status, del_flag, create_by, create_time, update_by, update_time, remark
		from user_comment
    </sql>
    
    <select id="selectCommentById" parameterType="Long" resultMap="UserCommentResult">
        <include refid="selectUserCommentVo"/>
        where comment_id = #{commentId}
    </select>
    
    <select id="selectCommentList" parameterType="UserComment" resultMap="UserCommentResult">
        <include refid="selectUserCommentVo"/>
        <where>
			AND del_flag = '0'
			<if test="articleId != null">
				AND article_id = #{articleId}
			</if>
			<if test="userId != null">
				AND user_id = #{userId}
			</if>
			<if test="parentId != null">
				AND parent_id = #{parentId}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by is_top desc, comment_id desc
    </select>

    <select id="selectCommentsByArticleId" parameterType="Long" resultMap="UserCommentResult">
        <include refid="selectUserCommentVo"/>
        where article_id = #{articleId}
        and parent_id is null
        and status = '1'
        order by is_top desc, comment_id desc
    </select>

    <select id="selectRepliesByParentId" parameterType="Long" resultMap="UserCommentResult">
        <include refid="selectUserCommentVo"/>
        where parent_id = #{parentId}
        and status = '1'
        order by comment_id asc
    </select>
    
    <insert id="insertComment" parameterType="UserComment" useGeneratedKeys="true" keyProperty="commentId">
        insert into user_comment (
			<if test="articleId != null">article_id, </if>
			<if test="userId != null">user_id, </if>
			<if test="userName != null and userName != '' ">user_name, </if>
			<if test="userAvatar != null and userAvatar != '' ">user_avatar, </if>
			<if test="content != null and content != '' ">content, </if>
			<if test="parentId != null">parent_id, </if>
			<if test="replyToUserId != null">reply_to_user_id, </if>
			<if test="replyToUserName != null and replyToUserName != '' ">reply_to_user_name, </if>
			<if test="likeCount != null">like_count, </if>
			<if test="replyCount != null">reply_count, </if>
			<if test="isTop != null and isTop != '' ">is_top, </if>
			<if test="status != null and status != '' ">status, </if>
			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
			<if test="articleId != null">#{articleId}, </if>
			<if test="userId != null">#{userId}, </if>
			<if test="userName != null and userName != ''">#{userName}, </if>
			<if test="userAvatar != null and userAvatar != ''">#{userAvatar}, </if>
			<if test="content != null and content != ''">#{content}, </if>
			<if test="parentId != null">#{parentId}, </if>
			<if test="replyToUserId != null">#{replyToUserId}, </if>
			<if test="replyToUserName != null and replyToUserName != ''">#{replyToUserName}, </if>
			<if test="likeCount != null">#{likeCount}, </if>
			<if test="replyCount != null">#{replyCount}, </if>
			<if test="isTop != null and isTop != ''">#{isTop}, </if>
			<if test="status != null and status != ''">#{status}, </if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
		)
    </insert>
	 
    <update id="updateComment" parameterType="UserComment">
        update user_comment 
        <set>
            <if test="articleId != null">article_id = #{articleId}, </if>
            <if test="userId != null">user_id = #{userId}, </if>
            <if test="userName != null">user_name = #{userName}, </if>
            <if test="userAvatar != null">user_avatar = #{userAvatar}, </if>
            <if test="content != null">content = #{content}, </if>
            <if test="parentId != null">parent_id = #{parentId}, </if>
            <if test="replyToUserId != null">reply_to_user_id = #{replyToUserId}, </if>
            <if test="replyToUserName != null">reply_to_user_name = #{replyToUserName}, </if>
            <if test="likeCount != null">like_count = #{likeCount}, </if>
            <if test="replyCount != null">reply_count = #{replyCount}, </if>
            <if test="isTop != null">is_top = #{isTop}, </if>
            <if test="status != null and status != ''">status = #{status}, </if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
        </set>
        where comment_id = #{commentId}
    </update>

    <update id="incrementLikeCount" parameterType="Long">
        update user_comment set like_count = like_count + 1 where comment_id = #{commentId}
    </update>

    <update id="incrementReplyCount" parameterType="Long">
        update user_comment set reply_count = reply_count + 1 where comment_id = #{commentId}
    </update>
	
    <delete id="deleteCommentByIds" parameterType="String">
        delete from user_comment where comment_id in 
        <foreach item="commentId" collection="array" open="(" separator="," close=")">
            #{commentId}
        </foreach>
    </delete>
    
</mapper>